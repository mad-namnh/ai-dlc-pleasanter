          }
        },
        {
          "op": "create",
          "save": "r2",
          "data": {
            "Title": "kbprobe D21 control",
            "StartTime": "$lastweek",
            "CompletionTime": "$tomorrow"
          }
        },
        {
          "op": "exec",
          "record": "$r2",
          "process": "withview",
          "expectHttp": 200
        }
