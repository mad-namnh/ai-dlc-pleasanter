{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/docs/agent-rules.md)",
      "Edit(/docs/review-criteria.md)",
      "Edit(/evals/**/expected.md)",
      "Edit(/templates/project/CLAUDE.md)",
      "Edit(//**/.pls/**)",
      "Read(//**/.pls/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/credentials.json)"
    ]
  }
}