{
  "environments": {
    "dev": {
      "_comment": "Pleasanter dev nội bộ MADLAB. Chỉ role='dev' + allow_write=true mới được ghi.",
      "base_url": "https://pleasanter-dev.example.internal",
      "api_key_env": "PLEASANTER_DEV_API_KEY",
      "tenant_id": 1,
      "role": "dev",
      "allow_write": true,
      "ca_bundle": null
    },
    "local": {
      "base_url": "http://localhost:50001",
      "api_key_env": "PLEASANTER_LOCAL_API_KEY",
      "tenant_id": 1,
      "role": "dev",
      "allow_write": true
    },
    "customer-stg": {
      "_comment": "Ví dụ: chỉ để export (đọc). role khác 'dev' => script luôn từ chối ghi.",
      "base_url": "https://pleasanter-stg.customer.example",
      "api_key_env": "PLEASANTER_CUSTOMER_STG_API_KEY",
      "role": "stg",
      "allow_write": false
    }
  },
  "site_ids": [
    0
  ],
  "roundtrip_parent_id": 0,
  "_comment_parent": "roundtrip_parent_id: SiteId của 1 thư mục (フォルダ) riêng cho spike trên dev, vd 'zz_spike_roundtrip'. Site tạo ở chế độ create sẽ nằm dưới đó.",
  "api_version": 1.1,
  "endpoints": {
    "get_site": "/api/items/{id}/getsite",
    "create_site": "/api/items/{id}/createsite",
    "update_site": "/api/items/{id}/updatesite"
  },
  "volatile_keys": [
    "ApiKey",
    "SiteId",
    "ParentId",
    "InheritPermission",
    "TenantId",
    "Ver",
    "Creator",
    "Updator",
    "CreatedTime",
    "UpdatedTime",
    "Timestamp",
    "ApiCountDate",
    "ApiCount"
  ],
  "_comment_volatile": "volatile_keys: chỉ bỏ ở cấp site. volatile_nested_keys: bỏ ở mọi cấp — để trống trừ khi chắc chắn (SiteId lồng là tham chiếu chéo site).",
  "volatile_nested_keys": [
    "UpdatedTime",
    "CreatedTime"
  ]
}
