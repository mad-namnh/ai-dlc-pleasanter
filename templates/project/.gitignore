.pls/

# Test credentials for dev (generated, never committed)
tests/seed/

# Migration backups hold business data (I7) — never committed; keep the folder only
migrations/*/backup/*
!migrations/*/backup/.keep

# Release packages for the customer (pls package): built from releases/, the manifest stays in releases/<R>/
dist/

# Working notes kept local (team rollout N21): regenerated by pls (xref, adopt) or read by nobody else
# (triage notes, env-compare values). Everything pls or a gate reads on another machine stays in git.
ops/xref/
ops/adopt/
ops/triage/
ops/env-compare/

# A developer's sandbox releases and bootstraps (environment dev-<name>, ADR-0011): the drift baseline of that
# sandbox only, on that developer's machine. Releases of the shared environments stay in git.
releases/R-*-dev-*/
releases/B-*-dev-*/
